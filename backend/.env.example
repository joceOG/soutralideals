# Backend API — variables d'environnement (copier vers backend/.env)

MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/soutralideals?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development

# Auth JWT — génère avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

SENTRY_DSN=

GOOGLE_MAPS_API_KEY=

EMAIL_USER=
EMAIL_PASS=

# OTP SMS (Infobip ou Twilio — mode dev si absent)
# STAB-12D : required = OTP bloquant (STAB-08/09) | deferred = bêta sans SMS obligatoire
# STAB-12E — bêta Google Play recommandée :
PHONE_VERIFICATION_MODE=deferred
OTP_REQUIRED=true
# OTP_REQUIRED=true = fallback sécurisé si PHONE_VERIFICATION_MODE est absent
# EMAIL_VERIFICATION_REQUIRED_BEFORE_PUBLIC_RELEASE — inscription locale deferred
# accepte un email sans preuve de possession (risque squatting) ; à traiter avant release publique
INFOBIP_API_KEY=
INFOBIP_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

REDIS_HOST=localhost
REDIS_PORT=6379

# --- Field Recensement V1 (R1-10) ---
# Fail-closed : absente / false / invalide → V1 désactivée (503 FIELD_RECENSEMENT_V1_DISABLED).
# Accepte uniquement "true" ou "false" exact (minuscules, après trim). TRUE/False/1/yes → invalide → V1 off.
# PRODUCTION : laisser false tant que le pilote n’est pas explicitement activé sur cet env.
# FIELD_RECENSEMENT_V1=false
# Obligatoire si V1=true : versionCode Android minimal (entier positif, pas versionName).
# Pilote candidat : aligner sur versionCode APK signé (ex. 13).
# FIELD_RECENSEMENT_MIN_BUILD_ANDROID=13
# Retry-After (secondes) pour 503 flag off — défaut 300
# FIELD_RECENSEMENT_RETRY_AFTER_SECONDS=300

# --- Field Recensement V1 rate limit (Phase 7A) ---
# Store actuel = mémoire processus (1 instance). DETTE : store Redis avant multi-instance.
# FIELD_RECENSEMENT_RL_WINDOW_SECONDS=900
# FIELD_RECENSEMENT_RL_CREATE=30
# FIELD_RECENSEMENT_RL_CORRECTION=60
# FIELD_RECENSEMENT_RL_READ=120
# FIELD_RECENSEMENT_RL_ADMIN=120
# fail-open si store indisponible (true) — documenté ; false → 503
# FIELD_RECENSEMENT_RL_FAIL_OPEN=true

# --- CORS pilote (dashboard) — AUCUN wildcard avec credentials ---
# Exemple pilote (ajuster à l’origine réelle du dashboard) :
# ALLOWED_ORIGINS=https://soutralideals.com,https://www.soutralideals.com,https://dashboard.soutralideals.com

# --- Télémétrie pilote sans PII ---
# FIELD_RECENSEMENT_PILOT_LOG_EVENTS=false

# --- Field Recensement Media GC (R1-12) ---
# Défaut fail-closed : ENABLED absent=false ; DRY_RUN absent=true.
# Suppression réelle exige ENABLED=true + DRY_RUN=false + TTL/quarantaine/batch valides
# + CLI --execute --confirm=DELETE_MANAGED_FIELD_MEDIA. Ne jamais activer en prod sans revue.
# FIELD_RECENSEMENT_MEDIA_GC_ENABLED=false
# FIELD_RECENSEMENT_MEDIA_GC_DRY_RUN=true
# Exemples test uniquement — valeurs production à décider :
# FIELD_RECENSEMENT_MEDIA_GC_ORPHAN_TTL_HOURS=72
# FIELD_RECENSEMENT_MEDIA_GC_QUARANTINE_HOURS=24
# FIELD_RECENSEMENT_MEDIA_GC_BATCH_SIZE=100

# --- Field Recensement Reconciler (R1-15) ---
# Défaut fail-closed : ENABLED absent=false ; DRY_RUN absent=true.
# Mutations exigent ENABLED=true + DRY_RUN=false + params valides
# + CLI --execute --confirm=RECONCILE_FIELD_RECENSEMENTS. Pas de scheduler prod.
# FIELD_RECENSEMENT_RECONCILER_ENABLED=false
# FIELD_RECENSEMENT_RECONCILER_DRY_RUN=true
# Exemples test — valeurs production à décider :
# FIELD_RECENSEMENT_RECONCILER_STALE_AFTER_MINUTES=15
# FIELD_RECENSEMENT_RECONCILER_BATCH_SIZE=100
# FIELD_RECENSEMENT_RECONCILER_LEASE_MS=120000
# FIELD_RECENSEMENT_RECONCILER_MAX_ATTEMPTS=8

# Firebase Admin SDK (FCM push notifications)
# Chemin vers le fichier JSON téléchargé depuis Firebase Console
GOOGLE_APPLICATION_CREDENTIALS=

# Google OAuth — vérification idToken (mobile + web)
# Client ID Web → Google Cloud Console → APIs & Services → Identifiants
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# Client ID Android (optionnel, recommandé pour mobile)
GOOGLE_ANDROID_CLIENT_ID=
# Secret Web — backend seulement, JAMAIS dans Flutter / frontend
GOOGLE_CLIENT_SECRET=
