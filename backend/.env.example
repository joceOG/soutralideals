# Backend API — variables d'environnement (copier vers backend/.env)

MONGO_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/soutralideals?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development

# Auth JWT — génère avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

SENTRY_DSN=

GOOGLE_MAPS_API_KEY=

EMAIL_USER=
EMAIL_PASS=

# OTP SMS (Infobip ou Twilio — mode dev si absent)
OTP_REQUIRED=false
INFOBIP_API_KEY=
INFOBIP_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

REDIS_HOST=localhost
REDIS_PORT=6379

# Firebase Admin SDK (FCM push notifications)
# Chemin vers le fichier JSON téléchargé depuis Firebase Console
GOOGLE_APPLICATION_CREDENTIALS=

# Google OAuth — vérification idToken (mobile + web)
# Client ID Web → Google Cloud Console → APIs & Services → Identifiants
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# Client ID Android (optionnel, recommandé pour mobile)
GOOGLE_ANDROID_CLIENT_ID=
# Secret Web — backend seulement, JAMAIS dans Flutter / frontend
GOOGLE_CLIENT_SECRET=
