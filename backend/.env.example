# Backend API — variables d'environnement (copier vers backend/.env)

MONGO_URL=
PORT=3000
NODE_ENV=development

JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

SENTRY_DSN=

GOOGLE_MAPS_API_KEY=

EMAIL_USER=
EMAIL_PASS=

# Google OAuth (login mobile / web)
# Client ID Web (obligatoire pour vérifier l'idToken)
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
# Client ID Android (optionnel, recommandé)
GOOGLE_ANDROID_CLIENT_ID=
# Secret Web — backend seulement, jamais dans Flutter
GOOGLE_CLIENT_SECRET=

# OTP SMS (Infobip ou Twilio — mode dev si absent)
OTP_REQUIRED=false
INFOBIP_API_KEY=
INFOBIP_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
